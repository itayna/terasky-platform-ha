#!/usr/bin/env bash
# scorecard — assert the platform bar for every service in the catalog and write
# CATALOG.md. Run it locally (`bin/scorecard`) or on a schedule
# (.github/workflows/scorecard.yml); it exits non-zero on any ❌, so compliance
# is a failing check rather than a dashboard nobody reads.
#
# Every row is derived from a source of truth, never from the catalog:
#   owner     the service repository's CODEOWNERS
#   pipeline  the version its delivery.yml pins
#   signed    cosign verify against the platform pipeline's OIDC identity
#   sbom      an SBOM attached to the deployed image
#   gitops    Argo CD Applications with selfHeal, probes, and canary analysis
#   promoted  a promotion commit in this repository's history for the prod tag
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
OWNER="${PLATFORM_OWNER:-itayna}"
OUT="CATALOG.md"
FAILED=0

command -v gh >/dev/null || { echo "gh is required" >&2; exit 2; }
# cosign is what makes the supply-chain columns real. The scheduled run always
# has it; a laptop might not, and a missing tool must read as "unknown" rather
# than quietly passing a service that is unsigned.
COSIGN=true
command -v cosign >/dev/null || { COSIGN=false; echo "note: cosign not installed - signature and SBOM columns unverified" >&2; }

# The one identity every service's image must be signed by, because every
# service is built by the same reusable pipeline. Second branch is the migration
# remnant for pre-v1 images (see ADR-0008).
identity_regexp() {
  printf '^https://github\.com/%s/(platform-workflows/\.github/workflows/java-service-delivery\.yml@refs/tags/v|%s/\.github/workflows/delivery\.yml@refs/heads/main$)' \
    "$OWNER" "$1"
}

# Pure printer: a command substitution runs in a subshell, so it must not be
# the thing that records failure.
mark() { case "$1" in 0) printf '✅' ;; 2) printf '⚠️' ;; *) printf '❌' ;; esac; }
newtag() { sed -n 's/^ *newTag: *//p' "environments/$1/$2/kustomization.yaml"; }

rows=""
while read -r svc repo; do
  dev_tag="$(newtag dev "$svc" 2>/dev/null || echo missing)"
  prod_tag="$(newtag prod "$svc" 2>/dev/null || echo missing)"
  image="ghcr.io/${OWNER}/${svc}"

  owner_line="$(gh api "repos/${repo}/contents/CODEOWNERS" \
      -H "Accept: application/vnd.github.raw" 2>/dev/null | sed -n 's/^\* *//p' | head -1 || true)"
  [ -n "$owner_line" ] && owner_cell="$owner_line" || { owner_cell='❌ none'; FAILED=1; }

  # Pinned pipeline version: a service on @v1 gets every mandatory step the
  # platform adds. Anything else is opted out and has to be visible.
  pinned="$(gh api "repos/${repo}/contents/.github/workflows/delivery.yml" \
      -H "Accept: application/vnd.github.raw" 2>/dev/null \
    | sed -n 's|.*platform-workflows/\.github/workflows/java-service-delivery\.yml@||p' | head -1 || true)"
  case "$pinned" in
    v1) pipeline_cell='✅ v1' ;;
    "") pipeline_cell='❌ own copy'; FAILED=1 ;;
    *)  pipeline_cell="⚠️ ${pinned}" ;;
  esac

  if $COSIGN; then
    cosign verify "${image}:${dev_tag}" \
      --certificate-identity-regexp="$(identity_regexp "$svc")" \
      --certificate-oidc-issuer=https://token.actions.githubusercontent.com \
      >/dev/null 2>&1 && signed=0 || signed=1
    [ -n "$(cosign download sbom "${image}:${dev_tag}" 2>/dev/null | head -c1 || true)" ] && sbom=0 || sbom=1
  else
    signed=2; sbom=2
  fi

  # Desired state lives in Git; Argo CD with selfHeal is what makes live state
  # follow it. Both halves have to be true for "deployed only via GitOps".
  gitops=0
  for env in dev prod; do
    app="gitops/argocd-apps/${env}/${svc}.yaml"
    [ -f "$app" ] && grep -q "selfHeal: true" "$app" || gitops=1
  done
  grep -qs "readinessProbe" "environments/dev/${svc}/deployment.yaml" || gitops=1
  grep -qs "templateName: health-check" "environments/prod/${svc}/rollout.yaml" || gitops=1

  # A prod tag nobody promoted through the gate is the failure this platform
  # exists to prevent, so it is checked against history, not intent.
  if [ "$prod_tag" = awaiting-first-promotion ]; then
    promoted='— not in prod'
  elif [ -n "$(git log --grep="promote ${svc}:${prod_tag} to prod" --format=%h -1)" ]; then
    promoted='✅'
  else
    promoted='❌'; FAILED=1
  fi

  [ "$signed" != 1 ] && [ "$sbom" != 1 ] && [ $gitops = 0 ] || FAILED=1
  rows+="| \`${svc}\` | ${owner_cell} | ${pipeline_cell} | \`${dev_tag}\` | $(mark $signed) | $(mark $sbom) | $(mark $gitops) | \`${prod_tag}\` | ${promoted} |"$'\n'
done < <(awk '/^- name:/{n=$3} /^[[:space:]]+repo:/{print n, $2}' catalog/services.yaml)

{
  echo "# Service catalog"
  echo
  echo "Generated by \`bin/scorecard\` from \`catalog/services.yaml\`. Live state is the"
  echo "Argo CD UI; this is the compliance view: what exists, who owns it, what is"
  echo "deployed where, and whether it still meets the platform bar."
  echo
  echo "| Service | Owner | Pipeline | Dev tag | Signed | SBOM | GitOps | Prod tag | Promoted via PR |"
  echo "|---|---|---|---|---|---|---|---|---|"
  printf '%s' "$rows"
  echo
  echo "Signed = cosign verify against the platform pipeline's OIDC identity."
  echo "SBOM = SPDX document attached to the deployed image."
  echo "GitOps = Argo CD Applications with selfHeal for both environments, probes"
  echo "in the dev Deployment, canary analysis wired into the prod Rollout."
  echo "Promoted via PR = the prod tag traces to a promotion commit in this history."
} > "$OUT"

cat "$OUT"
exit "$FAILED"
